tor-card{padding:22px}.sector-top{display:flex;gap:12px;align-items:baseline}.sector-index{font-size:10px;font-weight:900;color:var(--accent);letter-spacing:.1em}.sector-card h3{font-size:17px;margin:0;color:var(--ink)}.sector-tags{font-size:10.5px;font-weight:800;line-height:1.5;text-transform:uppercase;letter-spacing:.035em;color:var(--accent);margin:10px 0}.sector-card p{font-size:12.8px;line-height:1.62;color:var(--muted);margin:0}
    .impact-list{border-top:1px solid var(--line)}.impact-row{display:grid;grid-template-columns:56px minmax(0,1fr);gap:18px;padding:25px 4px;border-bottom:1px solid var(--line)}.impact-num{font-size:11px;font-weight:900;letter-spacing:.1em;color:var(--accent);padding-top:4px}.impact-row h3{font-size:19px;line-height:1.3;color:var(--ink);margin:0 0 8px}.impact-row p{font-size:13.5px;line-height:1.7;color:var(--muted);margin:0;max-width:920px}
    .leadership-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}.leadership-copy,.leadership-callout{padding:28px}.leadership-copy p,.leadership-callout p{font-size:13.8px;line-height:1.75;color:var(--muted);margin:0 0 15px}.leadership-copy p:last-child,.leadership-callout p:last-child{margin-bottom:0}.leadership-callout{border-top:3px solid var(--accent)}.leadership-callout h3{font-size:20px;line-height:1.35;color:var(--ink);margin:8px 0 14px}
    .certification-grid-four{grid-template-columns:repeat(2,minmax(0,1fr))!important}.certification-grid-four .certification-card{min-height:100%}.credential-link{display:inline-flex;margin-top:13px;color:var(--accent);font-size:11.5px;font-weight:800;text-decoration:none}.credential-link:hover{text-decoration:underline}.iso21434-panel{background:linear-gradient(145deg,var(--surface-2),var(--accent-soft))}.iso21434-mark{text-align:center;color:var(--ink);line-height:1}.iso21434-mark span{display:block;font-size:12px;font-weight:850;letter-spacing:.12em}.iso21434-mark strong{display:block;font-size:34px;letter-spacing:-.04em;margin:5px 0}.iso21434-mark small{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
    .credential-subsection{margin-top:34px}.education-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.education-card{padding:24px}.education-label{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:var(--accent);margin-bottom:12px}.education-card h3{font-size:18px;line-height:1.4;color:var(--ink);margin:0 0 6px}.education-school{font-size:13px;color:var(--muted);margin:0}.education-note,.membership-note,.training-note{font-size:12.5px;line-height:1.65;color:var(--muted);margin:14px 2px 0}.membership-grid-wide{grid-template-columns:repeat(2,minmax(0,1fr))!important}.training-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.training-row span{display:block;padding:16px 18px;border:1px solid var(--line);background:var(--surface);border-radius:14px;font-size:12.5px;font-weight:750;color:var(--ink)}
    .journey{position:relative}.journey-item{display:grid;grid-template-columns:94px 32px minmax(0,1fr);gap:14px;min-height:96px}.journey-year{font-size:11px;font-weight:900;color:var(--accent);padding-top:5px;text-align:right}.journey-line{position:relative;display:flex;justify-content:center}.journey-line::before{content:"";position:absolute;top:0;bottom:0;width:1px;background:var(--line)}.journey-line span{position:relative;z-index:1;width:10px;height:10px;border:2px solid var(--accent);background:var(--surface);border-radius:50%;margin-top:5px}.journey-content{padding:0 0 25px}.journey-content h3{font-size:18px;color:var(--ink);margin:0 0 6px}.journey-content p{font-size:12.5px;line-height:1.55;color:var(--muted);margin:0}
    .closing-panel{padding:36px}.closing-content{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(230px,.7fr);gap:36px;align-items:end}.closing-content h2{font-size:clamp(28px,4vw,46px);line-height:1.05;color:var(--ink);letter-spacing:-.04em;margin:0 0 20px}.closing-content p{font-size:14px;line-height:1.75;color:var(--muted);margin:0 0 13px;max-width:760px}.closing-keywords{font-size:10.5px;line-height:1.7;font-weight:850;letter-spacing:.045em;text-transform:uppercase;color:var(--accent);margin-top:20px}.closing-action{padding:24px;border-left:1px solid var(--line)}.location-line{font-size:11.5px;color:var(--muted);margin-top:15px}
    @media(max-width:1150px){.executive-profile,.leadership-grid,.closing-content{grid-template-columns:1fr}.profile-side{grid-template-columns:repeat(3,1fr)}.closing-action{border-left:0;border-top:1px solid var(--line)}}
    @media(max-width:820px){.expertise-grid,.sector-grid,.certification-grid-four,.education-grid,.membership-grid-wide,.training-row{grid-template-columns:1fr!important}.profile-side{grid-template-columns:1fr}.executive-profile{padding:24px}.impact-row{grid-template-columns:38px 1fr}.journey-item{grid-template-columns:78px 26px 1fr}.closing-panel{padding:26px}}

/* Supplied credential, education and professional-body logos */
.education-card{overflow:hidden}
.education-logo-panel{
  height:112px;margin:-1px -1px 20px;border-bottom:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;background:#fff;
  border-radius:inherit;border-bottom-left-radius:0;border-bottom-right-radius:0;padding:16px 20px;
}
.education-logo{display:block;max-width:100%;max-height:80px;object-fit:contain}
.education-logo-henley{max-height:84px}
.education-logo-rgu{max-height:68px}
.cert-logo-tuv{width:92px;height:92px;object-fit:contain}
.credential-brand-panel{background:#fff}
.membership-logo-wrap{
  width:98px;height:62px;flex:0 0 98px;padding:8px 9px;border-radius:12px;
  background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.membership-logo-wrap-dark{background:#0b1e2d;border-color:#173a54}
.membership-logo{display:block;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain}
.membership-logo-isa{max-width:58px;max-height:58px}
.membership-logo-isasecure{max-width:92px}
.membership-logo-instmc{max-width:90px}
.membership-logo-engcouncil{max-width:90px}
.membership-logo-ciisec{max-width:90px}
.membership-logo-ncsc{max-width:92px}
.membership-item{min-height:84px}
@media(max-width:640px){
  .education-logo-panel{height:96px}
  .membership-logo-wrap{width:82px;height:56px;flex-basis:82px}
}

/* Dark executive theme only */
:root{
  --page:#0c1117; --page-2:#101821; --surface:#121a23; --surface-2:#17212c;
  --surface-glass:rgba(18,26,35,.94); --ink:#f5f3ee; --ink-2:#e8e4dd;
  --muted:#aeb7c1; --muted-2:#7f8a96; --line:#263342; --line-strong:#35475a;
  --accent:#e07a5f; --accent-dark:#f09a82; --accent-soft:#2b1f1c; --accent-contrast:#11161c;
  --slate-950:var(--ink); --slate-900:#f0ece5; --slate-800:#ded9d1; --slate-700:#c8c2b9;
  --slate-600:var(--muted); --slate-500:#8f99a4; --slate-400:#6f7a86; --slate-300:#4c5967;
  --slate-200:var(--line); --slate-100:#18222d; --slate-50:#121922;
  --navy-900:var(--ink); --navy-800:#eee8df; --navy-700:#d9d1c6; --navy-600:#bdb4a9;
  --blue-50:var(--accent-soft); color-scheme:dark;
}
html,body{background:linear-gradient(145deg,var(--page),var(--page-2));color:var(--ink-2)}
body{background:
  radial-gradient(circle at 86% 8%,rgba(224,122,95,.08),transparent 26%),
  linear-gradient(145deg,var(--page),var(--page-2))}
.sidebar{background:linear-gradient(180deg,#111821,#0e151d);border-right:1px solid var(--line)}
.dock{background:rgba(15,22,30,.94);border-color:var(--line);box-shadow:0 12px 36px rgba(0,0,0,.22)}
.nav-link{color:var(--muted)}
.nav-link.active,.nav-link:hover{background:var(--accent-soft);color:var(--ink)}
.card,.contact-card,.social,.icon-box,.filter-btn,.standard,.contact-big,.eyebrow,.badge,.btn-secondary,.membership-item{
  background:linear-gradient(180deg,var(--surface),#111922);border-color:var(--line);color:var(--ink-2)
}
.hero h1,.section-title,.card h3,.closing-panel h2{color:var(--ink)}
.hero h1 span{color:var(--ink);background:none;-webkit-background-clip:initial}
.section-kicker,.meta,.sector-index{color:var(--accent)}
.section-copy,.card p,.sublead,.lead{color:var(--muted)}
.btn-primary{background:var(--accent);color:#121212;box-shadow:none}
.btn-primary:hover{background:#f09073}
.mobile-bar button{background:var(--surface-glass)!important;border-color:var(--line)!important;color:var(--ink)!important}

/* Executive content */
.executive-profile-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.75fr);gap:22px}
.executive-profile-main,.executive-focus{padding:30px}
.executive-lead{font-size:19px!important;line-height:1.65!important;color:var(--ink-2)!important}
.executive-profile-main p{font-size:15px;line-height:1.78;margin:0 0 16px}
.focus-list{display:grid;gap:10px;margin-top:18px}
.focus-list span{padding:12px 13px;border-radius:12px;background:#0f171f;border:1px solid var(--line);font-size:13px;font-weight:700;color:var(--ink-2)}

.leadership-grid,.impact-grid,.credential-summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.leadership-card,.impact-card,.credential-summary-card{padding:24px}
.leadership-card h3,.credential-summary-card h3{font-size:20px;line-height:1.35;margin:8px 0 10px}
.impact-card strong{display:block;font-size:18px;color:var(--ink);margin-bottom:8px}

.sector-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.sector-card{padding:26px}
.sector-head{display:grid;grid-template-columns:42px 1fr;gap:14px;align-items:start}
.sector-index{font-size:12px;font-weight:900;letter-spacing:.08em;padding-top:4px}
.sector-card h3{font-size:20px;line-height:1.35;margin:4px 0 12px}
.sector-card p{line-height:1.68}

.standing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}
.standing-card{padding:18px}
.standing-card strong{display:block;color:var(--ink);font-size:14px}
.standing-card span{display:block;color:var(--muted);font-size:12px;line-height:1.45;margin-top:5px}

.education-simple-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.education-simple-card{padding:26px}
.education-simple-card h3{font-size:21px;margin:7px 0 10px}

.closing-panel{padding:34px 34px 38px;background:
  radial-gradient(circle at 100% 0%,rgba(224,122,95,.10),transparent 30%),
  linear-gradient(180deg,var(--surface),#101820)}
.closing-panel h2{font-size:34px;letter-spacing:-.03em;margin:8px 0 18px}
.closing-panel p{max-width:820px;font-size:15.5px;line-height:1.75}
.closing-link{display:inline-flex;margin-top:12px;text-decoration:none}

@media(max-width:1100px){
  .executive-profile-grid,.leadership-grid,.sector-grid,.impact-grid,.credential-summary-grid,.education-simple-grid{grid-template-columns:1fr}
  .standing-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:640px){
  .executive-profile-main,.executive-focus,.leadership-card,.sector-card,.impact-card,.credential-summary-card,.education-simple-card,.closing-panel{padding:21px}
  .standing-grid{grid-template-columns:1fr}
  .closing-panel h2{font-size:28px}
}

/* Final dark-only executive layout */
html{data-theme:dark}
.executive-intro{max-width:900px}
.executive-intro p{font-size:15.5px;line-height:1.82;color:var(--muted);margin:0 0 16px}
.executive-intro .executive-lead{font-size:20px;line-height:1.62;color:var(--ink-2);max-width:900px}
.executive-stat-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:26px}
.executive-stat-row>div{padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
.executive-stat-row strong{display:block;color:var(--ink);font-size:18px;margin-bottom:6px}
.executive-stat-row span{display:block;color:var(--muted);font-size:11.5px;line-height:1.45}

.leadership-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.leadership-card{padding:25px}
.leadership-card h3{font-size:20px;line-height:1.35;margin:7px 0 10px}
.leadership-card p{line-height:1.7}

.sector-showcase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.sector-feature{padding:27px;position:relative;overflow:hidden}
.sector-feature::before{content:"";position:absolute;left:0;top:0;width:3px;height:100%;background:linear-gradient(var(--accent),transparent)}
.sector-label{font-size:11px;text-transform:upperc