ortant}
}
@media(max-width:560px){
  .rail-logo-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}

/* Current supplied professional marks */
.membership-brand.brand-ceng-current{
  background:#f7f7f5;
  padding:9px 12px;
}
.membership-brand.brand-ceng-current img{
  display:block;
  max-width:94%;
  max-height:54px;
  object-fit:contain!important;
}
.membership-brand.brand-isa-current{
  background:#f7f7f5;
  padding:8px;
}
.membership-brand.brand-isa-current img{
  display:block;
  max-width:58px;
  max-height:58px;
  object-fit:contain!important;
}
.logo-kudelski-security-current{
  max-width:92%!important;
  max-height:58px!important;
  object-fit:contain!important;
}
.logo-altera-infrastructure{
  max-width:92%!important;
  max-height:56px!important;
  object-fit:contain!important;
}

/* Credential badge links */
.credential-badge-link{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  text-decoration:none;
  cursor:pointer;
  position:relative;
  z-index:2;
}
.credential-badge-link img{
  transition:transform .22s ease,filter .22s ease;
}
.credential-badge-link:hover img,
.credential-badge-link:focus-visible img{
  transform:scale(1.035);
  filter:drop-shadow(0 8px 18px rgba(0,0,0,.22));
}
.credential-badge-link:focus-visible{
  outline:1px solid var(--accent);
  outline-offset:4px;
  border-radius:10px;
}

/* Manufacturing line illustration */
.sector-art-manufacturing{
  width:43%;
  right:-4px;
  bottom:-4px;
}

/* Visible Blog placeholder, intentionally inactive until blog.html exists */
.blog-placeholder{
  opacity:.58;
  cursor:default!important;
}
.blog-placeholder::after{
  content:"";
  display:inline-block;
  width:4px;
  height:4px;
  border-radius:50%;
  margin-left:5px;
  vertical-align:middle;
  background:var(--accent);
  opacity:.72;
}
.blog-placeholder:hover{
  background:transparent!important;
  color:var(--muted)!important;
}

/* Client carousel first slide can be dense: make 19 logos manageable */
.client-carousel-slide:first-child .client-logo-grid{
  grid-template-columns:repeat(5,minmax(0,1fr));
}
@media(max-width:1200px){
  .client-carousel-slide:first-child .client-logo-grid{
    grid-template-columns:repeat(4,minmax(0,1fr));
  }
}
@media(max-width:820px){
  .client-carousel-slide:first-child .client-logo-grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}
@media(max-width:560px){
  .client-carousel-slide:first-child .client-logo-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media(prefers-reduced-motion:reduce){
  .credential-badge-link img{transition:none!important}
}

/* Final professional-standing logo corrections */
.membership-brand.brand-chartered-engineer-restored{
  background:#f7f7f5;
  padding:8px 10px;
}
.membership-brand.brand-chartered-engineer-restored img{
  display:block;
  max-width:94%;
  max-height:58px;
  object-fit:contain!important;
  object-position:center!important;
}
.membership-brand.brand-isa-uk-restored{
  background:#f7f7f5;
  padding:7px 9px;
}
.membership-brand.brand-isa-uk-restored img{
  display:block;
  max-width:92%;
  max-height:60px;
  object-fit:contain!important;
  object-position:center!important;
}

/* Final ISA UK Section logo supplied by user */
.membership-brand.brand-isa-uk-final{
  background:#f7f7f5;
  padding:7px 10px;
}
.membership-brand.brand-isa-uk-final img{
  display:block;
  max-width:94%;
  max-height:60px;
  object-fit:contain!important;
  object-position:center!important;
}

/* Future CV download placeholder */
.cv-download-placeholder{
  display:inline-flex;
  align-items:center;
  gap:7px;
  opacity:.72;
  cursor:default!important;
  user-select:none;
}
.cv-download-placeholder:hover{
  transform:none!important;
  background:inherit!important;
  border-color:var(--line)!important;
  color:inherit!important;
}
.cv-download-icon{
  width:15px;
  height:15px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

/* Exact ISA UK Section logo supplied by user */
.membership-brand.brand-isa-uk-exact{
  background:#f7f7f5;
  padding:9px 10px;
}
.membership-brand.brand-isa-uk-exact img{
  display:block;
  width:96%;
  max-width:230px;
  max-height:58px;
  object-fit:contain!important;
  object-position:center!important;
}

/* Current OneSubsea mark supplied by user */
.logo-onesubsea{
  display:block;
  max-width:92%!important;
  max-height:58px!important;
  object-fit:contain!important;
  object-position:center!important;
  filter:none!important;
}

/* Product Security / CRA sector illustration */
.sector-art-product-security{
  width:41%;
  right:0;
  bottom:-2px;
}

/* Functional Safety credential: match the rest of the dark certification cards */
.cert-art-fse-dark{
  background:
    radial-gradient(circle at 72% 20%,rgba(224,122,95,.07),transparent 36%),
    linear-gradient(145deg,#0a1016,#111a23)!important;
  padding:18px 16px!important;
}
.cert-art-fse-dark::after{
  display:block!important;
}
.cert-art-fse-dark .fse-dark-logo{
  display:block;
  width:100%!important;
  height:auto!important;
  max-width:330px!important;
  max-height:104px!important;
  object-fit:contain!important;
  object-position:center!important;
  filter:none!important;
}

/* Newly supplied TÜV SÜD Functional Safety Expert artwork */
.cert-art-fse-dark .fse-dark-logo-new{
  display:block;
  width:100%!important;
  height:auto!important;
  max-width:360px!important;
  max-height:108px!important;
  object-fit:contain!important;
  object-position:center!important;
  filter:none!important;
}
</style>
</head>
