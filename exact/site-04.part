ase;letter-spacing:.1em;font-weight:850;color:var(--accent);margin-bottom:9px}
.sector-feature h3{font-size:21px;line-height:1.34;margin:0 0 12px}
.sector-feature p{font-size:14px;line-height:1.7;color:var(--muted)}
.sector-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}
.sector-tags span{font-size:10.5px;font-weight:750;padding:6px 9px;border:1px solid var(--line);border-radius:999px;background:#0f171f;color:var(--muted)}

.cert-grid-clean{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
.cert-clean{padding:0 20px 22px;overflow:hidden}
.credential-logo-panel{height:140px;margin:0 -20px 20px;display:flex;align-items:center;justify-content:center;background:#0b1219;border-bottom:1px solid var(--line);padding:18px}
.credential-logo-panel img{display:block;max-width:100%;max-height:100px;object-fit:contain}
.credential-logo-wide img{max-width:250px;max-height:82px}
.credential-logo-tuv img{max-width:95px;max-height:95px}
.cert-clean h3{font-size:17px;line-height:1.35;margin-top:7px}

.standing-block{margin-top:24px}
.standing-title{font-size:12px;text-transform:uppercase;letter-spacing:.11em;font-weight:850;color:var(--accent);margin-bottom:12px}
.standing-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.standing-item{min-height:96px;padding:16px;border:1px solid var(--line);border-radius:15px;background:var(--surface);display:flex;align-items:center;gap:13px}
.standing-logo{width:72px;height:55px;flex:0 0 72px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;padding:6px;overflow:hidden}
.standing-logo img{display:block;max-width:100%;max-height:100%;object-fit:contain}
.standing-logo-isa img{max-height:48px;max-width:60px}
.standing-item strong{display:block;color:var(--ink);font-size:13.5px}
.standing-item span{display:block;color:var(--muted);font-size:11.5px;line-height:1.45;margin-top:4px}
.standing-text-only{padding-left:19px}

.education-logo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.education-logo-card{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:22px;padding:0 24px 0 0;overflow:hidden;min-height:145px}
.education-brand{height:145px;background:#fff;border-right:1px solid var(--line);display:flex;align-items:center;justify-content:center;padding:18px}
.education-brand img{display:block;max-width:100%;max-height:90px;object-fit:contain}
.education-logo-card h3{font-size:20px;line-height:1.35;margin:6px 0 0}

.closing-panel{padding:36px;background:radial-gradient(circle at 100% 0%,rgba(224,122,95,.10),transparent 30%),linear-gradient(180deg,var(--surface),#101820)}
.closing-panel h2{font-size:34px;letter-spacing:-.03em;margin:8px 0 18px}
.closing-panel p{max-width:850px;font-size:15.5px;line-height:1.75}
.closing-link{display:inline-flex;margin-top:10px;text-decoration:none}

@media(max-width:1200px){
  .cert-grid-clean{grid-template-columns:repeat(2,minmax(0,1fr))}
  .standing-row{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:1000px){
  .executive-stat-row{grid-template-columns:repeat(2,minmax(0,1fr))}
  .leadership-grid,.sector-showcase,.education-logo-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
  .executive-stat-row,.cert-grid-clean,.standing-row{grid-template-columns:1fr}
  .education-logo-card{grid-template-columns:1fr;padding:0 20px 22px}
  .education-brand{height:110px;margin:0 -20px;border-right:0;border-bottom:1px solid var(--line)}
  .closing-panel{padding:24px}
}

.executive-profile-wrap{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.7fr);gap:22px;align-items:start}
.executive-copy p{font-size:15.5px;line-height:1.82;color:var(--muted);margin:0 0 16px}
.executive-copy .executive-lead{font-size:20px;line-height:1.62;color:var(--ink-2)}
.executive-copy strong{color:var(--ink)}
.executive-role-card{padding:26px}
.role-stack{display:grid;gap:10px;margin-top:16px}
.role-stack span{padding:12px 13px;border-radius:12px;background:#0f171f;border:1px solid var(--line);font-size:12.5px;font-weight:750;color:var(--ink-2)}
.leadership-grid,.impact-grid,.credential-summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.leadership-card,.impact-card,.credential-summary-card{padding:25px}
.leadership-card h3,.credential-summary-card h3{font-size:20px;line-height:1.35;margin:7px 0 10px}
.impact-card strong{display:block;color:var(--ink);font-size:18px;margin-bottom:8px}
.sector-showcase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.sector-feature{padding:27px;position:relative;overflow:hidden}
.sector-feature::before{content:"";position:absolute;left:0;top:0;width:3px;height:100%;background:linear-gradient(var(--accent),transparent)}
.sector-label{font-size:11px;text-transform:uppercase;letter-spacing:.1em;font-weight:850;color:var(--accent);margin-bottom:9px}
.sector-feature h3{font-size:21px;line-height:1.34;margin:0 0 12px}
.sector-feature p{font-size:14px;line-height:1.72;color:var(--muted)}
.sector-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}
.sector-tags span{font-size:10.5px;font-weight:750;padding:6px 9px;border:1px solid var(--line);border-radius:999px;background:#0f171f;color:var(--muted)}
.standing-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}
.standing-card{padding:18px}.standing-card strong{display:block;color:var(--ink);font-size:14px}.standing-card span{display:block;color:var(--muted);font-size:11.5px;line-height:1.45;margin-top:4px}
.education-simple-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.education-simple-card{padding:26px}.education-simple-card h3{font-size:21px;margin:7px 0 10px}
.closing-panel{padding:36px}.closing-panel h2{font-size:34px;letter-spacing:-.03em;margin:8px 0 18px}.closing-panel p{max-width:860px;font-size:15.5px;line-height:1.75}.closing-link{display:inline-flex;margin-top:10px;text-decoration:none}
@media(max-width:1100px){.executive-profile-wrap{grid-template-columns:1fr}.standing-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:900px){.leadership-grid,.sector-showcase,.impact-grid,.credential-summary-grid,.education-simple-grid{grid-template-columns:1fr}}
@media(max-width:640px){.standing-grid{grid-template-columns:1fr}.executive-role-card,.leadership-card,.sector-feature,.impact-card,.credential-summary-card,.education-simple-card,.closing-panel{padding:21px}}

/* Credentials, memberships and education refinement */
.credential-subhead{
  margin:30px 0 14px;display:flex;align-items:end;justify-content:space-between;
  gap:16px;padding-bottom:10px;border-bottom:1px solid var(--line)
}
.credential-subhead span{font-size:16px;font-weight:800;color:var(--ink);letter-spacing:-.01em}
.credential-subhead small{font-size:10.5px;text-transform:uppercase;letter-spacing:.11em;color:var(--muted-2);font-weight:800}
.memberships-heading{margin-top:36px}

.certification-showcase{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.certification-pro{
  display:grid;grid-template-columns:150px 1fr;align-items:stretch;overflow:hidden;
  min-height:190px;transition:transform .28s ease,border-color .28s ease,box-shadow .28s ease
}
.certification-pro:hover{
  transform:translateY(-4px);border-color:color-mix(in srgb,var(--accent) 42%,var(--line));
  box-shadow:0 18px 42px rgba(0,0,0,.20)
}
.cert-art{
  min-height:190px;display:flex;align-items:center;justify-content:center;
  padding:22px;background:linear-gradient(145deg,#0a1016,#111a23);
  border-right:1px solid var(--line);position:relative;overflow:hidden
}
.cert-art::after{
  content:"";position:absolute;width:100px;height:100px;border-radius:50%;
  background:rgba(224,122,95,.08);filter:blur(22px);transform:translate(40px,-45px)
}
.cert-art img{display:block;max-width:100%;max-height:112px;object-fit:contain;position:relative;z-index:1}
.cert-art-wide img{max-width:260px;max-height:78px}
.cert-art-tuv img{max-width:100px;max-height:100px}
.cert-copy{padding:24px 24px 22px}
.cert-copy h3{font-size:20px;line-height:1.35;margin:7px 0 10px}
.cert-copy p{font-size:13px;line-height:1.65;color:var(--muted);margin:0}

.memberships-clean{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px
}
.membership-clean{
  min-height:102px;padding:18px;border:1px solid var(--line);border-radius:15px;
  background:linear-gradient(180deg,var(--surface),#101820);
  position:relative;overflow:hidden;transition:transform .25s ease,border-color .25s ease,background .25s ease
}
.membership-clean::before{
  content:"";position:absolute;left:0;top:0;width:2px;height:100%;
  background:linear-gradient(var(--accent),transparent 78%);opacity:.75
}
.membership-clean:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 34%,var(--line))}
.membership-clean strong{display:block;color:var(--ink);font-size:14px;line-height:1.35;margin-bottom:6px}
.membership-clean span{display:block;color:var(--muted);font-size:11.5px;line-height:1.5}

.education-premium-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.education-premium{display:grid;grid-template-columns:180px 1fr;overflow:hidden;min-height:150px;transition:transform .25s ease,border-color .25s ease}
.education-premium:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 32%,var(--line))}
.education-logo-box{
  background:#f7f7f5;display:flex;align-items:center;justify-content:center;
  padding:20px;border-right:1px solid var(--line)
}
.education-logo-box img{display:block;max-width:100%;max-height:88px;object-fit:contain}
.education-premium-copy{padding:23px}
.education-premium-copy h3{font-size:20px;line-height:1.35;margin:6px 0 8px}
.education-premium-copy p{font-size:13px;line-height:1.65;color:var(--muted);margin:0}

/* Subtle executive motion. Content stays visible if JS fails. */
.hero-photo-inner{animation:portraitFloat 7s ease-in-out infinite}
@keyframes portraitFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}

.section-kicker::before{animation:accentPulse 2.8s ease-in-out infinite}
@keyframes accentPulse{0%,100%{opacity:.45;transform:scaleX(.86)}50%{opacity:1;transform:scaleX(1)}}

.js-motion .motion-item{
  opacity:0;transform:translateY(16px);
  transition:opacity .55s ease,transform .55s cubic-bezier(.2,.8,.2,1)
}
.js-motion .motion-item.motion-visible{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .hero-photo-inner,.section-kicker::before{animation:none!important}
  .js-motion .motion-item{opacity:1!important;transform:none!important;transition:none!important}
  .certification-pro,.membership-clean,.education-premium{transition:none!important}
}
@media(max-width:1100px){
  .memberships-clean{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:850px){
  .certification-showcase,.education-premium-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
  .certification-pro{grid-template-columns:1fr}
  .cert-art{min-height:130px;border-right:0;border-bottom:1px solid var(--line)}
  .memberships-clean{grid-template-columns:1fr}
  .education-premium{grid-template-columns:1fr}
  .education-logo-box{min-height:110px;border-right:0;border-bottom:1px solid var(--line)}
}

/* Executive refinements */
.memberships-clean{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px
}
.membership-logo-card{
  min-height:138px;padding:0;display:flex;flex-direction:column;overflow:hidden
}
.membership-logo-card::before{display:none}
.membership-brand{
  height:78px;display:flex;align-items:center;justify-content:center;position:relative;
  padding:11px 14px;background:#f7f7f4;border-bottom:1px solid var(--line);overflow:hidden
}
.membership-brand img{
  display:block;max-width:100%;max-height:55px;object-fit:contain;object-position:center
}
.membership-brand img[alt*="International Society of Automation"]{max-height:52px;max-width:70px}
.membership-brand img[alt*="Chartered Engineer"]{max-height:49px}
.membership-brand img[alt*="CIISec"]{max-height:43px}
.membership-brand img[alt*="NCSC"]{max-height:46px}
.membership-brand img[alt="ISASecure"]{max-height:52px}
.membership-brand-label{
  position:absolute;right:8px;bottom:7px;padding:3px 6px;border-radius:5px;
  background:#0d1721;color:#fff;font-size:8px;font-weight:850;letter-