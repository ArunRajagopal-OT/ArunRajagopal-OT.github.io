<!DOCTYPE html>

<html data-theme="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="Arun Rajagopal is an OT and industrial cyber security leader with 25+ years across industrial automation, control systems, IEC 62443, CNI, security architecture and cyber risk." name="description"/>
<meta content="#f5f4ef" name="theme-color"/>
<title>Arun Rajagopal | OT &amp; Industrial Cyber Security Leader</title>
<link href="data:image/svg+xml;base64," rel="icon"/>
<style>
    :root {
      --slate-950:#0f172a; --slate-900:#172033; --slate-800:#263247; --slate-700:#3d4b60;
      --slate-600:#5d697c; --slate-500:#748094; --slate-400:#94a3b8; --slate-300:#cbd5e1;
      --slate-200:#e2e8f0; --slate-100:#f1f5f9; --slate-50:#f8fafc;
      --navy-900:#16324f; --navy-800:#1e3a5f; --navy-700:#234b6e; --navy-600:#2c5a7c;
      --blue-50:#eff6ff; --green:#10b981; --white:#fff;
      --shadow-card:0 1px 3px rgba(15,23,42,.05),0 4px 12px rgba(15,23,42,.06);
      --shadow-hover:0 8px 20px rgba(15,23,42,.08),0 18px 35px rgba(15,23,42,.08);
      --shadow-premium:0 10px 30px rgba(15,23,42,.10),0 30px 60px rgba(15,23,42,.07);
      --sidebar:384px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
    body{margin:0;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--slate-800);background:linear-gradient(135deg,#f1f5f9 0%,#e2e8f0 50%,#f1f5f9 100%);background-attachment:fixed;min-height:100vh}
    ::selection{background:rgba(30,58,95,.16);color:var(--navy-900)} a{color:inherit;text-decoration:none} button{font:inherit}
    .sidebar{position:fixed;inset:0 auto 0 0;width:var(--sidebar);z-index:40;border-right:1px solid rgba(203,213,225,.9);background:linear-gradient(180deg,#fff 0%,rgba(248,250,252,.98) 50%,rgba(241,245,249,.96) 100%);box-shadow:4px 0 30px -12px rgba(0,0,0,.15);overflow:hidden}
    .sidebar::before{content:"";position:absolute;width:300px;height:300px;border-radius:50%;right:-160px;top:-150px;background:rgba(30,58,95,.08);filter:blur(45px)} .sidebar::after{content:"";position:absolute;width:280px;height:280px;border-radius:50%;left:-170px;bottom:-150px;background:rgba(100,116,139,.12);filter:blur(50px)}
    .dot-pattern{position:absolute;inset:0;opacity:.018;background-image:radial-gradient(circle at 1px 1px,#1e3a5f 1px,transparent 0);background-size:24px 24px;pointer-events:none}
    .sidebar-inner{height:100%;position:relative;z-index:2;display:flex;flex-direction:column;align-items:stretch;padding:40px 32px;overflow-y:auto;scrollbar-width:none} .sidebar-inner::-webkit-scrollbar{display:none}
    .identity{text-align:center} .avatar-wrap{position:relative;width:152px;height:152px;margin:0 auto} .avatar-ring{position:absolute;inset:-5px;border-radius:50%;background:linear-gradient(45deg,#cbd5e1,#bfdbfe,#cbd5e1);opacity:.72}
    .avatar{position:absolute;inset:0;border-radius:50%;overflow:hidden;border:5px solid white;box-shadow:var(--shadow-premium);background:#e2e8f0} .avatar img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease} .avatar:hover img{transform:scale(1.07)}
    .name{font-size:30px;line-height:1;font-weight:800;letter-spacing:-.04em;margin:24px 0 12px;background:linear-gradient(90deg,#16324f,#234b6e,#27364c);-webkit-background-clip:text;color:transparent}
    .role-pill{display:inline-block;padding:8px 14px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--navy-900);background:rgba(30,58,95,.055);border:1px solid rgba(30,58,95,.11)}
    .divider{height:1px;background:linear-gradient(90deg,transparent,rgba(30,58,95,.18),transparent);margin:30px 0}
    .contact-stack{display:grid;gap:12px} .contact-card{display:flex;align-items:center;gap:13px;padding:12px;border-radius:14px;border:1px solid var(--slate-200);background:rgba(255,255,255,.72);box-shadow:0 1px 2px rgba(15,23,42,.03);transition:.25s ease}
    .contact-card:hover{transform:translateY(-1px);border-color:rgba(30,58,95,.23);box-shadow:var(--shadow-card)} .icon-box{width:38px;height:38px;flex:0 0 38px;border-radius:10px;display:grid;place-items:center;background:#fff;border:1px solid var(--slate-200);color:var(--navy-800)} .icon-box svg{width:17px;height:17px;fill:currentColor}
    .contact-label{font-size:10px;color:var(--slate-400);font-weight:800;text-transform:uppercase;letter-spacing:.12em;margin-bottom:2px} .contact-text{font-size:13px;color:var(--slate-700);font-weight:650;overflow-wrap:anywhere}
    .sidebar-bottom{margin-top:auto;padding-top:26px} .connect-label{text-align:center;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.15em;color:var(--slate-400);margin-bottom:12px}
    .social-row{display:flex;justify-content:center;gap:10px} .social{width:44px;height:44px;border-radius:12px;background:white;border:1px solid var(--slate-200);display:grid;place-items:center;color:var(--slate-500);transition:.25s ease;box-shadow:0 1px 3px rgba(15,23,42,.03)} .social:hover{color:white;background:var(--navy-800);border-color:var(--navy-800);transform:translateY(-2px);box-shadow:var(--shadow-hover)} .social svg{width:20px;height:20px;fill:currentColor}
    .mini-note{font-size:9px;color:var(--slate-400);text-align:center;margin-top:20px;letter-spacing:.12em;font-weight:700}
    .main{margin-left:var(--sidebar);min-height:100vh} .dock-shell{position:fixed;z-index:50;top:0;left:var(--sidebar);right:0;display:flex;justify-content:center;padding:24px 20px;pointer-events:none;transition:.35s ease} .dock-shell.scrolled{padding-top:14px}
    .dock{pointer-events:auto;display:flex;align-items:center;gap:4px;padding:6px;background:rgba(255,255,255,.94);backdrop-filter:blur(16px);border:1px solid rgba(203,213,225,.85);border-radius:999px;box-shadow:var(--shadow-card);transition:.35s ease} .dock-shell.scrolled .dock{box-shadow:var(--shadow-premium)}
    .nav-link{border:0;background:transparent;padding:10px 16px;border-radius:999px;color:var(--slate-600);font-size:13px;font-weight:650;cursor:pointer;transition:.22s ease} .nav-link:hover,.nav-link.active{background:rgba(239,246,255,.88);color:var(--navy-900)}
    .dock-divider{height:20px;width:1px;background:var(--slate-200);margin:0 6px} .resume-btn{border:0;cursor:pointer;padding:10px 17px;border-radius:999px;color:white;background:linear-gradient(90deg,var(--navy-900),var(--navy-800));font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;box-shadow:0 4px 10px rgba(30,58,95,.22);transition:.22s ease} .resume-btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(30,58,95,.23)} .mobile-bar{display:none}
    .section-wrap{max-width:1152px;margin:0 auto;padding-left:48px;padding-right:48px} .hero{min-height:100vh;position:relative;overflow:hidden;display:flex;align-items:center;padding-top:90px;padding-bottom:80px}
    .orb{position:absolute;border-radius:50%;filter:blur(68px);pointer-events:none;opacity:.7;animation:drift 14s ease-in-out infinite} .orb.one{width:410px;height:410px;right:3%;top:5%;background:rgba(30,64,175,.08)} .orb.two{width:460px;height:460px;right:8%;bottom:7%;background:rgba(100,116,139,.07);animation-delay:-4s} .orb.three{width:380px;height:380px;left:8%;top:42%;background:rgba(79,70,229,.055);animation-delay:-8s} @keyframes drift{0%,100%{transform:translate(0,0)}25%{transform:translate(-22px,16px)}50%{transform:translate(12px,34px)}75%{transform:translate(28px,-12px)}}
    .hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:290px 1fr;align-items:center;gap:72px;width:100%} .hero-photo{position:relative;width:286px;height:286px} .hero-photo::after{content:"";position:absolute;inset:16px -12px -16px 12px;border-radius:50%;background:linear-gradient(45deg,rgba(30,58,95,.17),rgba(148,163,184,.18));filter:blur(24px);z-index:-1}
    .hero-photo-inner{width:100%;height:100%;overflow:hidden;border-radius:50%;border:6px solid white;box-shadow:var(--shadow-premium);outline:1px solid rgba(203,213,225,.6)} .hero-photo img{width:100%;height:100%;object-fit:cover;transform:scale(1.04)}
    .eyebrow{display:inline-flex;align-items:center;gap:9px;padding:7px 14px;border-radius:999px;background:white;border:1px solid var(--slate-200);box-shadow:var(--shadow-card);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--slate-800);margin-bottom:20px} .eyebrow-dot{width:8px;height:8px;border-radius:50%;background:var(--navy-900)}
    .hero h1{font-size:68px;line-height:1.05;letter-spacing:-.055em;margin:0 0 22px;color:var(--slate-950);font-weight:850} .hero h1 span{background:linear-gradient(90deg,var(--navy-900),var(--navy-700),var(--slate-800));-webkit-background-clip:text;color:transparent}
    .badges{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px} .badge{padding:9px 16px;border-radius:999px;background:var(--slate-100);border:1px solid var(--slate-200);box-shadow:var(--shadow-card);font-size:13px;font-weight:750;color:var(--slate-800);transition:.25s ease} .badge:hover{transform:translateY(-1px);box-shadow:var(--shadow-hover)}
    .lead{font-size:19px;line-height:1.7;color:var(--slate-700);max-width:700px;margin:0 0 14px} .lead strong{color:var(--slate-950)} .sublead{font-size:16px;line-height:1.7;color:var(--slate-600);max-width:700px;margin:0 0 12px} .italic{font-size:14px;color:var(--slate-500);font-style:italic;font-weight:550}
    .cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px} .btn-primary,.btn-secondary{display:inline-block;border:0;cursor:pointer;border-radius:999px;padding:13px 24px;font-size:13px;font-weight:700;transition:.25s ease} .btn-primary{background:linear-gradient(90deg,var(--navy-900),var(--navy-800));color:white;box-shadow:0 8px 18px rgba(30,58,95,.20)} .btn-secondary{background:white;color:var(--slate-600);border:1px solid var(--slate-200);box-shadow:var(--shadow-card)} .btn-primary:hover,.btn-secondary:hover{transform:translateY(-2px);box-shadow:var(--shadow-hover)} .live-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--green);margin-right:8px;box-shadow:0 0 0 4px rgba(16,185,129,.12)} .hero-line{position:absolute;left:48px;right:48px;bottom:42px;height:2px;background:linear-gradient(90deg,var(--slate-200),var(--slate-400),var(--slate-200));border-radius:999px}
    .content{max-width:1152px;margin:0 auto;padding:50px 48px 120px;display:grid;gap:112px} section{scroll-margin-top:105px} .section-kicker{font-size:12px;font-weight:850;text-transform:uppercase;letter-spacing:.15em;color:var(--navy-900);display:flex;align-items:center;gap:10px;margin-bottom:10px} .section-kicker::before{content:"";width:32px;height:2px;background:linear-gradient(90deg,var(--navy-900),var(--navy-700))} .section-title{font-size:38px;line-height:1.15;letter-spacing:-.035em;margin:0 0 34px;color:var(--slate-950);font-weight:820} .section-copy{max-width:780px;color:var(--slate-600);line-height:1.7;margin:-20px 0 34px}
    .cards-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px} .card{background:white;border:1px solid rgba(203,213,225,.85);border-radius:18px;padding:28px;box-shadow:var(--shadow-card);transition:.28s ease} .card:hover{transform:translateY(-2px);border-color:rgba(30,58,95,.22);box-shadow:var(--shadow-hover)}
    .edu-card{display:grid;grid-template-columns:56px 1fr;gap:18px;align-items:start} .card-icon{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:rgba(30,58,95,.075);border:1px solid rgba(30,58,95,.10);color:var(--navy-900)} .card-icon svg{width:22px;height:22px;fill:currentColor} .meta{font-size:11px;text-transform:uppercase;letter-spacing:.10em;font-weight:800;color:var(--slate-400);margin-bottom:7px} .card h3{font-size:18px;line-height:1.35;margin:0 0 6px;color:var(--slate-950)} .card h4{font-size:14px;line-height:1.4;margin:0 0 12px;color:var(--navy-800)} .card p{font-size:14px;line-height:1.65;color:var(--slate-600);margin:0}
    .time