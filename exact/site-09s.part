<style>
/* Speaking + Publications (added) */
.speaking-block{display:grid;gap:18px}
.speaking-block + .speaking-block{margin-top:34px}
.speaking-status{display:inline-flex;align-items:center;gap:8px;font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;padding:6px 12px;border-radius:999px;border:1px solid var(--line-strong);color:var(--muted);background:rgba(255,255,255,.02)}
.speaking-status::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--muted-2)}
.speaking-status.is-upcoming{color:var(--ink);border-color:color-mix(in srgb,var(--accent) 55%,var(--line));background:var(--accent-soft)}
.speaking-status.is-upcoming::before{background:var(--accent);box-shadow:0 0 0 4px rgba(224,122,95,.18)}
.speaking-event{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:30px;align-items:center;padding:24px}
.speaking-event.is-portrait{grid-template-columns:minmax(0,250px) minmax(0,1fr)}
.speaking-flyer{display:block;border-radius:14px;overflow:hidden;border:1px solid var(--line);background:var(--surface-2);line-height:0}
.speaking-flyer img{display:block;width:100%;height:auto}
.speaking-event-copy{display:grid;gap:12px;align-content:start;justify-items:start}
.speaking-event-copy h3{font-size:24px;line-height:1.3;letter-spacing:-.015em;margin:0;color:var(--ink)}
.speaking-event-copy p{margin:0;font-size:14px;line-height:1.7;color:var(--muted)}
.speaking-event-copy p.speaking-subtitle{margin-top:-4px;font-size:16px;line-height:1.5;font-weight:600;color:var(--ink-2)}
.speaking-flyer-play{position:relative;cursor:pointer;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
.speaking-flyer-play:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:0 14px 34px rgba(0,0,0,.28)}
.speaking-flyer-play:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.speaking-play-hotspot{position:absolute;left:56.5%;top:88.2%;width:40.8%;height:8.9%;border-radius:999px;pointer-events:none;transition:box-shadow .25s ease,background-color .25s ease}
.speaking-flyer-play:hover .speaking-play-hotspot,.speaking-flyer-play:focus-visible .speaking-play-hotspot{background:rgba(255,255,255,.12);box-shadow:0 0 0 3px rgba(255,255,255,.55),0 0 22px rgba(255,122,88,.55)}
.speaking-highlights-head{margin-top:6px;scroll-margin-top:105px}
@media(prefers-reduced-motion:reduce){.speaking-flyer-play,.speaking-play-hotspot{transition:none}.speaking-flyer-play:hover{transform:none}}
.speaking-facts{display:grid;gap:6px;margin:4px 0 6px;padding:0;list-style:none}
.speaking-facts li{font-size:13px;line-height:1.55;color:var(--ink-2);display:flex;gap:10px}
.speaking-facts li span{min-width:52px;font-size:10.5px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);padding-top:2px}
.speaking-intro{margin:6px 0 0;font-size:15px;line-height:1.7;color:var(--ink-2);max-width:760px}
.speaking-video-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.speaking-video{padding:0;overflow:hidden;display:flex;flex-direction:column}
.speaking-video-frame{position:relative;aspect-ratio:16/9;background:#05080c;border-bottom:1px solid var(--line)}
.speaking-video-frame video,.speaking-video-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.speaking-video-frame video{object-fit:contain;background:#05080c}
.speaking-video-body{padding:18px 22px 22px;display:grid;gap:8px}
.speaking-video-body .meta{margin:0}
.speaking-video-body p.speaking-caption{margin:0;font-size:15px;line-height:1.6;font-weight:600;color:var(--ink)}
.speaking-full{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);gap:26px;align-items:center;padding:18px}
.speaking-full .speaking-video-frame{border:1px solid var(--line);border-radius:12px;overflow:hidden}
.speaking-full-copy{display:grid;gap:8px;justify-items:start}
.speaking-full-copy h3{margin:0;font-size:19px;line-height:1.35;color:var(--ink)}
.speaking-full-copy p{margin:0;font-size:13px;line-height:1.65;color:var(--muted)}
.pub-feature{display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:0;padding:0;overflow:hidden}
.pub-art{position:relative;min-height:260px;background:radial-gradient(circle at 18% 12%,rgba(224,122,95,.18),transparent 46%),linear-gradient(160deg,var(--surface-2),#0f161e);border-right:1px solid var(--line);display:grid;place-items:center;padding:28px}
.pub-art svg{width:100%;max-width:240px;height:auto;fill:none;stroke:var(--accent);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.pub-art svg .soft{stroke:var(--muted-2);opacity:.55}
.pub-art-label{position:absolute;left:24px;top:22px;font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.pub-copy{padding:32px 34px;display:grid;gap:12px;align-content:center;justify-items:start}
.pub-copy h3{margin:0;font-size:25px;line-height:1.3;letter-spacing:-.015em;color:var(--ink)}
.pub-byline{margin:0;font-size:14px;line-height:1.7;color:var(--muted)}
.pub-byline strong{color:var(--ink-2);font-weight:700}
.pub-tags{display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 8px}
.pub-tags span{font-size:11px;font-weight:700;padding:6px 11px;border-radius:999px;border:1px solid var(--line);color:var(--muted);background:rgba(255,255,255,.02)}
@media(max-width:900px){.speaking-event,.speaking-event.is-portrait,.speaking-full,.pub-feature{grid-template-columns:1fr}.speaking-event.is-portrait .speaking-flyer{max-width:340px}.pub-art{border-right:0;border-bottom:1px solid var(--line);min-height:200px}}
@media(max-width:760px){.speaking-video-grid{grid-template-columns:1fr}}
@media(max-width:560px){.speaking-event{padding:18px;gap:20px}.speaking-event-copy h3{font-size:21px}.pub-copy{padding:24px 22px}.pub-copy h3{font-size:21px}.speaking-full{padding:14px}}
</style><section class="reveal" id="speaking">
