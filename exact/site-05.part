spacing:.08em;text-transform:uppercase
}
.membership-text-mark{
  color:#173553;font-size:12px;font-weight:900;letter-spacing:.04em;text-align:center
}
.membership-copy{padding:14px 15px 16px}
.membership-copy strong{display:block;color:var(--ink);font-size:13.5px;line-height:1.3;margin-bottom:4px}
.membership-copy span{display:block;color:var(--muted);font-size:11px;line-height:1.42}

.cert-art-fse{
  padding:14px;background:#fff
}
.cert-art-fse::after{display:none}
.cert-art-fse .fse-full-logo{
  width:100%!important;height:auto!important;max-width:330px!important;max-height:110px!important;
  object-fit:contain!important;object-position:center!important
}

.education-text-grid{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px
}
.education-text-card{padding:25px}
.education-text-card h3{font-size:21px;line-height:1.35;margin:7px 0 9px}
.education-text-card p{font-size:13px;line-height:1.65;color:var(--muted);margin:0}

@media(max-width:1150px){
  .memberships-clean{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:760px){
  .memberships-clean,.education-text-grid{grid-template-columns:1fr}
}

/* =========================================================
   FINAL MOTION DIRECTION
   Subtle background ambience only. Content remains static.
   ========================================================= */

/* Disable previous foreground / reveal animation */
.hero-photo-inner,
.section-kicker::before,
.orb{
  animation:none!important;
}
.js-motion .motion-item,
.motion-item,
.reveal{
  opacity:1!important;
  transform:none!important;
  transition:none!important;
}

/* Keep cards visually calm: no floating / lifting */
.card:hover,
.certification-pro:hover,
.membership-clean:hover,
.education-text-card:hover,
.education-premium:hover,
.sector-feature:hover,
.leadership-card:hover,
.impact-card:hover{
  transform:none!important;
}

/* Subtle animated technical background */
body{
  position:relative;
  isolation:isolate;
  overflow-x:hidden;
}
body::before{
  content:"";
  position:fixed;
  inset:-8%;
  z-index:-2;
  pointer-events:none;
  background-image:
    linear-gradient(rgba(138,158,176,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(138,158,176,.035) 1px, transparent 1px),
    radial-gradient(circle at 1px 1px, rgba(224,122,95,.055) 1px, transparent 1.4px);
  background-size:56px 56px,56px 56px,28px 28px;
  opacity:.52;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.72),rgba(0,0,0,.30) 52%,transparent 96%);
  -webkit-mask-image:linear-gradient(to bottom,rgba(0,0,0,.72),rgba(0,0,0,.30) 52%,transparent 96%);
  animation:ambientGridDrift 46s linear infinite;
}
body::after{
  content:"";
  position:fixed;
  inset:-18%;
  z-index:-3;
  pointer-events:none;
  background:
    radial-gradient(circle at 18% 18%, rgba(224,122,95,.08), transparent 24%),
    radial-gradient(circle at 82% 34%, rgba(93,128,153,.07), transparent 27%),
    radial-gradient(circle at 52% 86%, rgba(224,122,95,.045), transparent 30%);
  filter:blur(42px);
  opacity:.8;
  animation:ambientGlowShift 28s ease-in-out infinite alternate;
}

/* A very faint scan line in the hero only */
.hero::after{
  content:"";
  position:absolute;
  left:0;
  right:0;
  top:18%;
  height:1px;
  pointer-events:none;
  z-index:0;
  opacity:.16;
  background:linear-gradient(90deg,transparent 0%,rgba(224,122,95,.42) 48%,transparent 100%);
  animation:ambientScan 16s ease-in-out infinite;
}
.hero-grid{position:relative;z-index:1}

@keyframes ambientGridDrift{
  0%{transform:translate3d(0,0,0)}
  100%{transform:translate3d(56px,56px,0)}
}
@keyframes ambientGlowShift{
  0%{transform:translate3d(-1.5%,0,0) scale(1)}
  50%{transform:translate3d(1%,1.5%,0) scale(1.025)}
  100%{transform:translate3d(2%,-1%,0) scale(1.01)}
}
@keyframes ambientScan{
  0%,100%{transform:translateY(-18px);opacity:.08}
  50%{transform:translateY(210px);opacity:.18}
}

/* Accessibility: a completely static page when reduced motion is requested */
@media(prefers-reduced-motion:reduce){
  body::before,
  body::after,
  .hero::after{
    animation:none!important;
  }
}

/* Logo visibility corrections */
.membership-brand.brand-dark{
  background:linear-gradient(145deg,#07131f,#0b2234);
  border-bottom-color:#1e3a50;
}
.membership-brand.brand-ciisec img{
  width:92%;
  max-width:190px;
  max-height:42px;
  object-fit:contain;
}
.membership-brand.brand-ncsc img{
  width:96%;
  max-width:210px;
  max-height:54px;
  object-fit:contain;
}

/* ISA United Kingdom Section: use the ISA mark with an explicit UK Section wordmark.
   This avoids relying on a cropped source badge where "UK" was not visible. */
.membership-brand.brand-isa-uk{
  background:#f7f8fa;
  display:flex;
  flex-direction:row;
  gap:12px;
  align-items:center;
  justify-content:center;
  padding:9px 12px;
}
.brand-isa-uk .isa-uk-main-logo{
  width:54px;
  height:54px;
  max-width:54px!important;
  max-height:54px!important;
  object-fit:contain;
  flex:0 0 54px;
}
.isa-uk-wordmark{
  display:flex;
  flex-direction:column;
  line-height:1.05;
  text-align:left;
}
.isa-uk-wordmark strong{
  color:#073f6d;
  font-size:10px;
  font-weight:900;
  letter-spacing:.075em;
  white-space:nowrap;
}
.isa-uk-wordmark span{
  color:#236391;
  font-size:9px;
  font-weight:850;
  letter-spacing:.13em;
  margin-top:4px;
}

/* Prevent all membership logos from being clipped by their panels */
.membership-brand{
  overflow:visible;
}
.membership-brand img{
  object-fit:contain!important;
  object-position:center!important;
}

/* =========================================================
   INDUSTRIAL LINE-ART DETAIL
   Deliberately subtle: it supports the content, never competes.
   ========================================================= */

/* Sidebar schematic */
.sidebar{position:fixed;overflow:hidden}
.sidebar-inner{position:relative;z-index:2}
.sidebar-network-art{
  position:absolute;
  left:-14px;
  right:auto;
  bottom:-18px;
  width:calc(100% + 28px);
  height:calc(100% + 36px);
  z-index:1;
  pointer-events:none;
  opacity:.72;
}
.sidebar-network-pulse{
  fill:#e07a5f;
  opacity:.20;
  filter:drop-shadow(0 0 3px rgba(224,122,95,.22));
}

/* Keep the identity/contact content visually dominant */
.sidebar .dot-pattern{opacity:.015}

/* Sector card line-art */
.sector-feature{
  position:relative;
  overflow:hidden;
  isolation:isolate;
}
.sector-content-layer{
  position:relative;
  z-index:2;
}
.sector-line-art{
  position:absolute;
  right:-8px;
  bottom:-2px;
  width:46%;
  max-width:245px;
  height:auto;
  z-index:1;
  pointer-events:none;
  opacity:.085;
  color:#a8b8c5;
  transition:opacity .35s ease;
}
.sector-feature:hover .sector-line-art{
  opacity:.12;
}
.sector-draw{
  fill:none;
  stroke:currentColor;
  stroke-width:1.05;
  stroke-linecap:round;
  stroke-linejoin:round;
  vector-effect:non-scaling-stroke;
}
.sector-draw path{
  stroke-dasharray:1;
  stroke-dashoffset:0;
}

/* Draw once only when the card first enters the viewport */
.sector-feature.sector-awaiting-draw .sector-draw path{
  stroke-dashoffset:1;
}
.sector-feature.sector-drawn .sector-draw path{
  animation:sectorLineDraw .95s cubic-bezier(.35,.7,.25,1) forwards;
}
.sector-feature.sector-drawn .sector-draw path:nth-child(2n){animation-delay:.05s}
.sector-feature.sector-drawn .sector-draw path:nth-child(3n){animation-delay:.10s}
.sector-feature.sector-drawn .sector-draw path:nth-child(4n){animation-delay:.14s}

@keyframes sectorLineDraw{
  to{stroke-dashoffset:0}
}

/* Slightly different compositions so the cards don't look templated */
.sector-art-offshore{width:43%;right:-4px;bottom:-3px}
.sector-art-energy{width:42%;right:0;bottom:-2px}
.sector-art-rail{width:49%;right:-12px;bottom:-5px}
.sector-art-pharma{width:40%;right:0;bottom:-3px}
.sector-art-aviation{width:45%;right:-8px;bottom:-4px}
.sector-art-services{width:39%;right:4px;bottom:1px}

/* Preserve readability on smaller cards/screens */
@media(max-width:1100px){
  .sector-line-art{width:38%;opacity:.07}
}
@media(max-width:700px){
  .sector-line-art{width:46%;opacity:.055;right:-18px}
  .sidebar-network-art{opacity:.52}
}

/* Reduced motion: artwork is simply visible, never animated */
@media(prefers-reduced-motion:reduce){
  .sidebar-network-pulse{display:none}
  .sector-feature.sector-awaiting-draw .sector-draw path,
  .sector-feature.sector-drawn .sector-draw path{
    stroke-dashoffset:0!important;
    animation:none!important;
  }
}

/* =========================================================
   Sidebar enrichment + hero fine-line artwork
   ========================================================= */
.sidebar{
  overflow:hidden;
}
.sidebar-inner{
  gap:18px;
}
.identity .role-pill{
  margin-top:10px;
  font-size:11px;
  letter-spacing:.1em;
}

/* Sidebar additional compact sections */
.sidebar-executive-stack{
  display:grid;
  gap:12px;
}
.sidebar-mini-block{
  position:relative;
  border:1px solid rgba(255,255,255,.06);
  border-radius:15px;
  padding:14px 14px 13px;
  background:linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.01));
  backdrop-filter: blur(4px);
}
.sidebar-mini-kicker{
  font-size:10px;
  font-weight:850;
  letter-spacing:.11em;
  text-transform:uppercase;
  color:var(--accent);
  margin-bottom:10px;
}
.sidebar-metrics{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:8px;
}
.sidebar-metric{
  padding:10px 8px;
  border-radius:12px;
  background:rgba(10,15,22,.42);
  border:1px solid rgba(255,255,255,.045);
  text-align:center;
}
.sidebar-metric strong{
  display:block;
  color:var(--ink);
  font-size:14px;
  line-height:1.1;
}
.sidebar-metric span{
  display:block;
  color:var(--muted);
  font-size:9.5px;
  line-height:1.35;
  margin-top:5px;
}
.sidebar-focus-list{
  display:grid;
  gap:8px;
}
.sidebar-focus-list span{
  display:block;
  padding:9px 10px;
  border-radius:11px;
  background:rgba(10,15,22,.38);
  border:1px solid rgba(255,255,255,.04);
  color:var(--ink-2);
  font-size:11px;
  line-height:1.35;
}
.sidebar-tag-cloud{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}
.sidebar-tag-cloud span{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:7px 10px;
  border-radius:999px;
  background:rgba(10,15,22,.36);
  border:1px solid rgba(255,255,255,.045);
  color:var(--muted);
  font-size:10px;
  font-weight:750;
  line-height:1;
}

/* Let bottom trust marks breathe a bit after new blocks */
.sidebar-bottom{
  margin-top:2px;
}

/* Hero faint technical artwork */
.hero{
  position:relative;
  overflow:hidden;
}
.hero-fine-art{
  position:absolute;
  pointer-events:none;
  z-index:0;
  opacity:.065;
  color:#97aabb;
}
.hero-fine-art-one{
  right:3.5%;
  top:10%;
  width:min(33vw, 380px);
}
.hero-fine-art-two{
  left:34%;
  bottom:7%;
  width:min(28vw, 320px);
}
.hero-art-stroke{
  fill:none;
  stroke:currentColor;
  stroke-width:1;
  stroke-linecap:round;
  stroke-linejoin:round;
  vector-effect:non-scaling-stroke;
}
.hero-grid{
  position:relative;
  z-index:1;
}

/* Slightly dim hero art on smaller screens to avoid clutter */
@media(max-width:1200px){
  .hero-fine-art-one{width:min(30vw, 320px); opacity:.055}
  .hero-fine-art-two{width:min(26vw, 270px); left:38%; opacity:.05}
}
@media(max-width:900px){
  .sidebar-executive-stack{gap:10px}
  .hero-fine-art-one{right:-4%; top:8%; width:250px; opacity:.045}
  .hero-fine-art-two{left:52%; bottom:4%; width:200px; opacity:.04}
}
@media(max-width:700px){
  .sidebar-metrics{grid-template-columns:1fr 1fr 1fr}
  .hero-fine-art{display:none;}
}

/* Respect reduced motion preferences; these elements are static already,
   but keep their rendering consistent. */
@media(prefers-reduced-motion:reduce){
  .sidebar-mini-block,
  .sidebar-metric,
  .sidebar-focus-list span,
  .sidebar-tag-cloud span{
    transition:none!important;
  }
}

/* =========================================================
   Final sidebar simplification + subtle hero illustrations
   ========================================================= */

/* Sidebar: lighter, less crowded */
.sidebar-executive-stack{
  display:grid;
  gap:10px;
}
.sidebar-mini-block{
  padding:13px 13px 12px;
}
.sidebar-metrics-simple{
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7px;
}
.sidebar-metrics-simple .sidebar-metric{
  padding:9px 6px 8px;
  min-height:58px;
}
.sidebar-metrics-simple .sidebar-metri